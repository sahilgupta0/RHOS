# =============================================================================
# RHOS Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Application ---
APP_NAME=RHOS
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Authentication ---
# Options: "firebase" (production) or "local" (demo/development)
AUTH_MODE=local
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Firebase ---
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# --- MongoDB ---
MONGODB_URI=mongodb+srv://sahilgupta0cluster0.jlojpag.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=rhos

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro

# --- Google Cloud Speech (optional) ---
GOOGLE_SPEECH_ENABLED=false

# --- Google Cloud TTS (optional) ---
GOOGLE_TTS_ENABLED=false

# --- Google Maps (optional) ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Datasets ---
DATASETS_PATH=../datasets
